# Database (Required)
# Demo mode allows the public demo pages to use fixtures without a database.
# Set DEMO_MODE="false" and configure real PostgreSQL URLs for auth and data writes.
DEMO_MODE="true"
DEMO_READ_ONLY="true"
DEMO_SEED_USERS="false"
DATABASE_URL="postgresql://demo:demo@127.0.0.1:5432/gentech"
DIRECT_URL=""

# Better Auth (Required)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="local-demo-secret-change-before-deploy-000000000000"
BETTER_AUTH_URL="http://localhost:3000"

# Development Only (Optional)
# Set to "true" to skip email verification in development (ignored in production)
AUTH_SKIP_EMAIL_VERIFICATION="false"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Cloudinary Media (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Transactional Email (Optional)
RESEND_API_KEY=""
EMAIL_FROM=""

# Payment Provider (Optional)
# PayFast/Safepay for JazzCash, Easypaisa, cards
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
PAYFAST_API_BASE=""

# Google Maps (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Analytics (Optional)
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_MIXPANEL_TOKEN=""

# Application (Required)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="GenTech"

# Node Environment
NODE_ENV="development"
